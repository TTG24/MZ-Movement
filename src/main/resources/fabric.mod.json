{
	"schemaVersion": 1,
	"id": "tacticalmovement",
	"version": "${version}",
	"name": "MZ-Movement",
	"description": "The client mod for The Blocky Zombies (MinecraftZombies): tactical movement, animated zombies, crawlers, gore and death cutscenes.",
	"authors": [
		"MZ Cod Mod"
	],
	"license": "All-Rights-Reserved",
	"icon": "assets/tacticalmovement/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.mzcod.tacticalmovement.TacticalMovement"
		],
		"client": [
			"com.mzcod.tacticalmovement.client.TacticalMovementClient"
		]
	},
	"mixins": [
		"tacticalmovement.mixins.json",
		{
			"config": "tacticalmovement.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.20.1",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*"
	}
}